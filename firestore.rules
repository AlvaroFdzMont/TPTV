rules_version = '2';
// TPTV · Reglas de las cuentas y la peña. Cópialas en Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Nombre de usuario → cuenta. Solo puede reservarlo la cuenta cuyo correo interno es «usuario@usuarios.tptv.app»
    match /usernames/{u} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 20;
      allow create, update: if request.auth != null
        && request.auth.token.email == u + '@usuarios.tptv.app'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.u == u
        && request.resource.data.keys().hasOnly(['uid', 'u']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Ficha de cada pescador: la escribe solo él; la leen él y sus amigos (lista «viewers»)
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'username', 'bio', 'avatar', 'theme', 'fav', 'tec', 'showcase', 'friends', 'viewers', 'catches', 'stats', 'updated'])
        && request.resource.data.viewers is list && request.resource.data.viewers.size() <= 60
        && request.resource.data.friends is list && request.resource.data.friends.size() <= 60
        && request.resource.data.catches is list && request.resource.data.catches.size() <= 150
        && (!('showcase' in request.resource.data) || request.resource.data.showcase.size() <= 6)
        && (!('bio' in request.resource.data) || request.resource.data.bio.size() <= 160);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Solicitudes de amistad: id = destinatario_remitente
    match /requests/{id} {
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 't']);
      allow read, delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
